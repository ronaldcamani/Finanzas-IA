# Copia este archivo a .env y completa tus claves:
#   cp .env.example .env

# Gemini (gratis en https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
# Opcional: modelo a usar (por defecto gemini-2.5-flash)
MODELO_GEMINI=gemini-2.5-flash

# LangSmith (https://smith.langchain.com → Settings → API Keys)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finanzas-ia
